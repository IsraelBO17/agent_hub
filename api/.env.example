# Local defaults for every REQUIRED setting, and for any setting you want to change locally.
# Settings read this file first, then .env (gitignored, your overrides), then real environment
# variables. Deployed values come from ECS and Secrets Manager (docs/API_PROFILE.md); the image
# contains neither file. Every setting and its default is in src/app/core/settings.py.
# Safe local values only: never put a real secret here.
APP_ENV=local
DATABASE_URL=postgresql+psycopg://postgres:dev@localhost:55432/agent_hub
# Migrations use the direct (unpooled) URL when there is a pooler; falls back to DATABASE_URL.
DATABASE_URL_DIRECT=
SESSION_SIGNING_KEY=local-only-signing-key-change-me-0123456789
GOOGLE_CLIENT_ID=local-placeholder.apps.googleusercontent.com
FILES_BUCKET=local-files
APP_ORIGIN=http://localhost:5173
LOG_JSON=false
