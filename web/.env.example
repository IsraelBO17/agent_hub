# Build-time settings (standard §19). Every VITE_* value ships to the browser: never put a secret here.
# Copy to .env.local for local development.

# The API's base URL (deployed: https://api-fleet.qucoon.com). In mock mode the mocks answer on this origin.
VITE_API_URL=http://localhost:5173
# true: MSW answers every API call (standard §11.5). Never true in a build that talks to a real API.
VITE_API_MOCKS=true
# Error reporting (standard §21). Empty: off.
VITE_SENTRY_DSN=
VITE_ENVIRONMENT=local
VITE_RELEASE=
