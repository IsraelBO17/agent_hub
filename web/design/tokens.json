{
  "$description": "Example design variables in the W3C Design Tokens (DTCG) format. Replace with the design tool's export, or replace scripts/tokens/read-design.ts with an adapter for your design tool (standard §8.1).",
  "color": {
    "surface": { "$type": "color", "$value": "#ffffff", "$extensions": { "dark": "#0b0f14" } },
    "surface-muted": { "$type": "color", "$value": "#f4f5f7", "$extensions": { "dark": "#161b22" } },
    "surface-raised": { "$type": "color", "$value": "#ffffff", "$extensions": { "dark": "#1c222b" } },
    "text-primary": { "$type": "color", "$value": "#16191d", "$extensions": { "dark": "#f2f4f7" } },
    "text-secondary": { "$type": "color", "$value": "#5b6470", "$extensions": { "dark": "#a3acb8" } },
    "line": { "$type": "color", "$value": "#e2e5ea", "$extensions": { "dark": "#2a313b" } },
    "brand": { "$type": "color", "$value": "#2f54d1", "$extensions": { "dark": "#7c96f2" } },
    "on-brand": { "$type": "color", "$value": "#ffffff", "$extensions": { "dark": "#0b0f14" } },
    "hover": { "$type": "color", "$value": "#eef0f3", "$extensions": { "dark": "#222933" } },
    "danger": { "$type": "color", "$value": "#c62828", "$extensions": { "dark": "#ff8a80" } },
    "chart-1": { "$type": "color", "$value": "#2f54d1" },
    "chart-2": { "$type": "color", "$value": "#0f9d76" },
    "chart-3": { "$type": "color", "$value": "#d97706" },
    "chart-4": { "$type": "color", "$value": "#9333ea" },
    "chart-5": { "$type": "color", "$value": "#64748b" }
  },
  "font-family": {
    "sans": { "$type": "fontFamily", "$value": ["Geist Variable", "ui-sans-serif", "system-ui", "sans-serif"] },
    "mono": { "$type": "fontFamily", "$value": ["ui-monospace", "SFMono-Regular", "Menlo", "monospace"] }
  },
  "font-size": {
    "xs": { "$type": "dimension", "$value": "12px", "$extensions": { "lineHeight": "16px" } },
    "sm": { "$type": "dimension", "$value": "14px", "$extensions": { "lineHeight": "20px" } },
    "base": { "$type": "dimension", "$value": "16px", "$extensions": { "lineHeight": "24px" } },
    "lg": { "$type": "dimension", "$value": "18px", "$extensions": { "lineHeight": "28px" } },
    "2xl": { "$type": "dimension", "$value": "24px", "$extensions": { "lineHeight": "32px" } }
  },
  "radius": {
    "base": { "$type": "dimension", "$value": "10px" }
  },
  "layout": {
    "sidebar-width": { "$type": "dimension", "$value": "256px" },
    "content-width": { "$type": "dimension", "$value": "768px" }
  }
}
